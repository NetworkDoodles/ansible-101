{
  // Network Doodles lab environment · Ansible 101 for networking.
  // Everything runs inside this one container: its own Docker engine (the CapeOS switches live in
  // there), containerlab, Ansible, Python, and a browser IDE.
  //
  //   The site    "Open the lab" on the guide page: the lab app in a codespace, no editor (labs.networkdoodles.com)
  //   VS Code     "Dev Containers: Reopen in Container", then http://localhost:8000 for the lab app
  //   Browser     devcontainer up, then http://localhost:8000 (the lab app: the guide and VS Code)
  "name": "Network Doodles · Ansible 101",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "privileged": true,
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  // Codespaces checks the repo out into a world-writable folder, and Ansible won't read ansible.cfg from
  // one. Naming it explicitly makes every terminal pick it up.
  "containerEnv": { "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible.cfg" },

  "features": {
    "ghcr.io/coder/devcontainer-features/code-server:2": {
      "host": "0.0.0.0",
      "port": "13337",
      "auth": "none",
      "workspace": "/workspaces/${localWorkspaceFolderBasename}",
      "disableTelemetry": true,
      "disableUpdateCheck": true,
      "extensions": "srl-labs.vscode-containerlab,redhat.ansible,redhat.vscode-yaml,ms-python.python"
    }
  },

  // 8000: the lab app (.devcontainer/lab-ui/): the guide on the left, VS Code (code-server, 13337) in a tab, both
  // behind this one port. Nothing behind it has a login of its own, so locally it's published on this machine's
  // loopback only.
  "appPort": ["127.0.0.1:8000:8000"],
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "Lab", "onAutoForward": "openBrowser", "protocol": "http" },
    "13337": { "label": "code-server (also in the lab app)", "onAutoForward": "silent" }
  },

  // First of all, before anything else is set up: the lab app, so it's up in seconds and shows the rest.
  "onCreateCommand": "bash .devcontainer/lab-ui/start.sh",
  // Once, when the container is created: the switch images, inside this container's own Docker.
  "postCreateCommand": "make setup images",
  // Every start: the lab app (already running on the first start), its tunnel if the lab was opened from the
  // site, and the switches (they're what every task talks to), side by side.
  "postStartCommand": { "app": "bash .devcontainer/lab-ui/start.sh; bash .devcontainer/lab-ui/tunnel.sh", "lab": "for i in $(seq 1 60); do curl -fs -o /dev/null -m 2 http://127.0.0.1:8000/api/status && break; sleep 1; done; nice -n 10 make up" },

  "customizations": {
    "vscode": {
      "extensions": ["srl-labs.vscode-containerlab", "redhat.ansible", "redhat.vscode-yaml", "ms-python.python"],
      "settings": {
        "task.allowAutomaticTasks": "on",
        "python.defaultInterpreterPath": "/home/vscode/.venvs/lab/bin/python",
        "python.useEnvironmentsExtension": false,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
