{
  // Network Doodles lab environment · Ansible 101 for networking.
  // Everything runs inside this one container: its own Docker engine (the SR Linux switches live in
  // there), containerlab, Ansible, Python, and a browser IDE.
  //
  //   Codespaces  the badge in the README: nothing to install
  //   VS Code     "Dev Containers: Reopen in Container"
  //   Browser     devcontainer up, then http://localhost:13337 (code-server)
  "name": "Network Doodles · Ansible 101",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "privileged": true,
  "remoteUser": "vscode",
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  // Codespaces checks the repo out into a world-writable folder, and Ansible won't read ansible.cfg from
  // one. Naming it explicitly makes every terminal pick it up.
  "containerEnv": { "ANSIBLE_CONFIG": "${containerWorkspaceFolder}/ansible.cfg" },

  "features": {
    "ghcr.io/coder/devcontainer-features/code-server:2": {
      "host": "0.0.0.0",
      "port": "13337",
      "auth": "none",
      "workspace": "/workspaces/${localWorkspaceFolderBasename}",
      "disableTelemetry": true,
      "disableUpdateCheck": true,
      "extensions": "srl-labs.vscode-containerlab,redhat.ansible,redhat.vscode-yaml,ms-python.python"
    }
  },

  // code-server has no password, so it is only ever published on this machine's loopback.
  "appPort": ["127.0.0.1:13337:13337"],
  "forwardPorts": [13337],
  "portsAttributes": { "13337": { "label": "code-server (browser IDE)", "onAutoForward": "silent" } },

  // Once, when the container is created: the switch images, inside this container's own Docker.
  "postCreateCommand": "make setup images",
  // Every start: the switches (they're what every task talks to).
  "postStartCommand": "make up",

  "customizations": {
    "vscode": {
      "extensions": ["srl-labs.vscode-containerlab", "redhat.ansible", "redhat.vscode-yaml", "ms-python.python"],
      "settings": {
        "task.allowAutomaticTasks": "on",
        "python.defaultInterpreterPath": "/home/vscode/.venvs/lab/bin/python",
        "python.useEnvironmentsExtension": false,
        "terminal.integrated.defaultProfile.linux": "zsh"
      }
    }
  }
}
