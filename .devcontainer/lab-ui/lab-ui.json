{
  "title": "Ansible 101",
  "guide": "https://networkdoodles.com/labs/ansible-101/",
  "network": {"name": "ans101", "nodes": 5},
  "launcher": "https://labs.networkdoodles.com",
  "chapters": [
    {"n": 1, "title": "Hello, Ansible", "tasks": [["1.1", "Meet the lab"], ["1.2", "Write the inventory"], ["1.3", "Ask the switches"]]},
    {"n": 2, "title": "Your first playbook", "tasks": [["2.1", "Your first playbook"], ["2.2", "Check mode first"]]},
    {"n": 3, "title": "Variables and facts", "tasks": [["3.1", "group_vars and host_vars"], ["3.2", "Facts"]]},
    {"n": 4, "title": "Loops, conditionals, templates", "tasks": [["4.1", "Interfaces from data"], ["4.2", "A report from a template"]]},
    {"n": 5, "title": "Handlers, tags, errors", "tasks": [["5.1", "Save only on change"], ["5.2", "Tags"], ["5.3", "When it goes wrong"]]},
    {"n": 6, "title": "Roles and collections", "tasks": [["6.1", "Playbooks into roles"], ["6.2", "Defaults and overrides"]]},
    {"n": 7, "title": "Secrets", "tasks": [["7.1", "Vault the password"]]},
    {"n": 8, "title": "Run it like production", "tasks": [["8.1", "Execution environments"], ["8.2", "ansible-lint"], ["8.3", "A CI job"]]}
  ],
  "terminal": {"make": "ssh", "var": "NODE"},
  "topology": {
    "hint": "Your playbooks reach these switches from the VS Code tab. Click one for its CLI, in a tab of its own; hover for its details.",
    "nodes": [
      {"id": "spine1", "icon": "switch", "x": 300, "y": 0, "sub": "spine", "what": "The spine: both leaves connect to it."},
      {"id": "leaf1", "icon": "switch", "x": 100, "y": 180, "sub": "leaf", "what": "A leaf switch, with host1 behind it."},
      {"id": "leaf2", "icon": "switch", "x": 500, "y": 180, "sub": "leaf", "what": "A leaf switch, with host2 behind it."},
      {"id": "host1", "icon": "pc", "x": 100, "y": 360, "sub": "host", "what": "A Linux host on leaf1.", "details": [["runs", "Linux"]]},
      {"id": "host2", "icon": "pc", "x": 500, "y": 360, "sub": "host", "what": "A Linux host on leaf2.", "details": [["runs", "Linux"]]}
    ],
    "links": [["spine1:e1-1", "leaf1:e1-49"], ["spine1:e1-2", "leaf2:e1-49"], ["leaf1:e1-1", "host1:eth1"], ["leaf2:e1-1", "host2:eth1"]]
  },
  "tabs": [
    {"id": "code", "name": "VS Code", "path": "/code/", "port": 13337, "strip": true},
    {"id": "topology", "name": "Topology", "kind": "topology"}
  ]
}
